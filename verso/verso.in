#!@PYTHON@
# Installed launcher (generated by Meson).
import gettext
import locale
import signal
import sys

sys.path.insert(1, "@pkgdatadir@")
signal.signal(signal.SIGINT, signal.SIG_DFL)

for module in (gettext, locale):
    module.bindtextdomain("verso", "@localedir@")
    module.textdomain("verso")

from verso import app  # noqa: E402

app.VERSION = "@VERSION@"
sys.exit(app.main())
