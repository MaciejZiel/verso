<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="verso">
  <schema id="io.github.maciejziel.Verso" path="/io/github/maciejziel/Verso/">
    <!-- Window and session -->
    <key name="window-width" type="i">
      <default>980</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>720</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="restore-session" type="b">
      <default>true</default>
      <summary>Restore session</summary>
      <description>Reopen the documents from the last session when Verso starts without files.</description>
    </key>
    <!-- Editor -->
    <key name="zoom" type="d">
      <default>1.0</default>
      <summary>Zoom level</summary>
    </key>
    <key name="wrap-lines" type="b">
      <default>true</default>
      <summary>Wrap lines</summary>
    </key>
    <key name="spellcheck" type="b">
      <default>true</default>
      <summary>Check spelling</summary>
    </key>
    <key name="style-scheme" type="s">
      <default>'Adwaita'</default>
      <summary>Style scheme</summary>
      <description>Syntax highlighting scheme; its light or dark variant follows the system style.</description>
    </key>
    <key name="use-system-font" type="b">
      <default>true</default>
      <summary>Use the system monospace font</summary>
    </key>
    <key name="custom-font" type="s">
      <default>'Monospace 11'</default>
      <summary>Editor font</summary>
    </key>
    <key name="show-line-numbers" type="b">
      <default>true</default>
      <summary>Show line numbers</summary>
    </key>
    <key name="highlight-current-line" type="b">
      <default>true</default>
      <summary>Highlight the current line</summary>
    </key>
    <key name="show-map" type="b">
      <default>false</default>
      <summary>Show the overview map</summary>
    </key>
    <key name="show-statusbar" type="b">
      <default>true</default>
      <summary>Show the status bar</summary>
    </key>
    <key name="show-whitespace" type="b">
      <default>false</default>
      <summary>Show spaces and tabs</summary>
    </key>
    <key name="show-right-margin" type="b">
      <default>false</default>
      <summary>Show the right margin</summary>
    </key>
    <key name="right-margin-position" type="u">
      <range min="20" max="250"/>
      <default>80</default>
      <summary>Right margin position</summary>
    </key>
    <key name="tab-width" type="u">
      <range min="1" max="16"/>
      <default>4</default>
      <summary>Tab width</summary>
    </key>
    <key name="insert-spaces" type="b">
      <default>true</default>
      <summary>Insert spaces instead of tabs</summary>
    </key>
    <key name="auto-indent" type="b">
      <default>true</default>
      <summary>Automatic indentation</summary>
    </key>
    <key name="auto-pair" type="b">
      <default>true</default>
      <summary>Close brackets and quotes automatically</summary>
    </key>
    <!-- Preview -->
    <key name="preview-theme" type="s">
      <choices><choice value="github"/><choice value="document"/><choice value="reader"/></choices>
      <default>'github'</default>
      <summary>Preview style</summary>
    </key>
    <key name="preview-width" type="s">
      <choices><choice value="narrow"/><choice value="normal"/><choice value="wide"/><choice value="full"/></choices>
      <default>'normal'</default>
      <summary>Width of the preview text</summary>
    </key>
    <key name="sync-scroll" type="b">
      <default>true</default>
      <summary>Synchronized scrolling</summary>
      <description>Scroll the editor and the preview together in the side by side view.</description>
    </key>
    <key name="default-mode-markdown" type="s">
      <choices><choice value="edit"/><choice value="split"/><choice value="preview"/></choices>
      <default>'preview'</default>
      <summary>Default view for Markdown files</summary>
    </key>
    <key name="default-mode-data" type="s">
      <choices><choice value="edit"/><choice value="split"/><choice value="preview"/></choices>
      <default>'preview'</default>
      <summary>Default view for JSON and other data files</summary>
    </key>
  </schema>
</schemalist>
