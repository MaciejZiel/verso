<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="verso">
  <schema id="io.github.maciejziel.Verso" path="/io/github/maciejziel/Verso/">
    <!-- Window and session -->
    <key name="window-width" type="i">
      <default>980</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>720</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <key name="restore-session" type="b">
      <default>true</default>
      <summary>Restore session</summary>
      <description>Reopen the documents from the last session when Verso starts without files.</description>
    </key>
    <key name="session-uris" type="as">
      <default>[]</default>
      <summary>Documents of the last session</summary>
    </key>
    <key name="session-selected" type="i">
      <default>0</default>
      <summary>Selected tab of the last session</summary>
    </key>
    <!-- Editor -->
    <key name="zoom" type="d">
      <default>1.0</default>
      <summary>Zoom level</summary>
    </key>
    <key name="wrap-lines" type="b">
      <default>true</default>
      <summary>Wrap lines</summary>
    </key>
    <key name="spellcheck" type="b">
      <default>true</default>
      <summary>Check spelling</summary>
    </key>
  </schema>
</schemalist>
