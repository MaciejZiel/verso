[Desktop Entry]
Type=Application
Name=Verso
GenericName=Text Editor
Comment=Edit and preview Markdown, JSON and other text files
# Translators: search terms for finding this application; keep the semicolons.
Keywords=text;editor;markdown;json;preview;csv;yaml;notes;
Exec=@BINDIR@/verso %U
Icon=io.github.maciejziel.Verso
Terminal=false
StartupNotify=true
DBusActivatable=false
Categories=GNOME;GTK;Utility;TextEditor;
MimeType=text/plain;text/markdown;text/x-markdown;application/json;text/csv;text/tab-separated-values;application/x-yaml;application/toml;application/xml;text/xml;text/html;image/svg+xml;text/x-python;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=@BINDIR@/verso --new-window
