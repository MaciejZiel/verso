<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.maciejziel.Verso</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Verso</name>
  <summary>Edit text with live previews</summary>
  <developer id="io.github.maciejziel">
    <name translate="no">Maciej Zieliński</name>
  </developer>
  <description>
    <p>Verso is a text editor for GNOME that shows what your files look like while you write them.</p>
    <p>Features:</p>
    <ul>
      <li>Live Markdown preview with tables, task lists, footnotes, math, diagrams and highlighted code</li>
      <li>Edit, preview or both side by side, with synchronized scrolling</li>
      <li>Outline of the headings to move around long documents</li>
      <li>Writing helpers: lists continue on Enter, shortcuts for bold, italic, code and links, pasted images saved next to the document, aligned tables</li>
      <li>JSON, JSON with comments, JSON Lines, YAML, TOML, XML, INI and .env files as a collapsible, searchable tree</li>
      <li>CSV and TSV as a table you can sort and filter</li>
      <li>Syntax highlighting for many languages and all GtkSourceView style schemes</li>
      <li>Focus mode that hides everything but the text</li>
      <li>Indentation from the project's .editorconfig</li>
      <li>Unsaved changes survive closing the app and restarting the computer</li>
      <li>Tabs, find and replace, spell checking, printing and export to PDF or HTML</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.maciejziel.Verso.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/MaciejZiel/verso/main/data/screenshots/markdown-split.png</image>
      <caption>Markdown with a live preview side by side</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/MaciejZiel/verso/main/data/screenshots/markdown-outline-dark.png</image>
      <caption>Preview with the outline of headings, in dark mode</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/MaciejZiel/verso/main/data/screenshots/json-tree.png</image>
      <caption>JSON as a collapsible, searchable tree</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/MaciejZiel/verso/main/data/screenshots/csv-table-dark.png</image>
      <caption>CSV as a table you can sort and filter</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/MaciejZiel/verso</url>
  <url type="bugtracker">https://github.com/MaciejZiel/verso/issues</url>
  <url type="vcs-browser">https://github.com/MaciejZiel/verso</url>
  <url type="translate">https://github.com/MaciejZiel/verso/tree/main/po</url>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <provides>
    <binary>verso</binary>
  </provides>
  <releases>
    <release version="0.9.0" date="2026-10-31">
      <description>
        <p>First preview release.</p>
      </description>
    </release>
  </releases>
</component>
